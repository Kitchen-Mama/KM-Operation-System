# SEC-A2 auth gateway - EXAMPLE ONLY. Every value here is a placeholder.
# NOTHING IN THIS FILE IS A CREDENTIAL AND NOTHING IN IT EVER BECOMES ONE.
# The real values live in Secret Manager and in the Cloud Run service configuration.

NODE_ENV=development

# The OAuth *web application* client id. Public by design - it ships in the browser.
# Still not committed with a real value, because a config file is the wrong place to learn it from.
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Exact origins. Comma separated. Bare scheme+host[:port], no path, no trailing slash, no wildcard.
ALLOWED_ORIGINS=http://localhost:8801

# Optional extra restriction. Leave BLANK to allow any verified Google account that is in the
# operator registry - which is what the external factory / warehouse / 3PL roles will need.
REQUIRED_HOSTED_DOMAIN=

# The Apps Script Web App /exec. Never committed with a real value.
APPS_SCRIPT_EXEC_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Phase one serves exactly these two, and every other action name is refused at the gateway.
ALLOWED_ACTIONS=productPricing.workspace.get,productPricing.siteUniverse.get

# HMAC keys. MOUNTED AS FILES, not environment variables: Cloud Run re-reads a mounted secret volume
# on every read but resolves a secret env var once at instance start - so only the file form can be
# rotated without a redeploy.
HMAC_ACTIVE_KEY_ID=k1
HMAC_ACTIVE_KEY_FILE=/var/secrets/kmga/active
HMAC_PREVIOUS_KEY_ID=
HMAC_PREVIOUS_KEY_FILE=

UPSTREAM_TIMEOUT_MS=25000
MAX_BODY_BYTES=65536
ASSERTION_TTL_SECONDS=120
PORT=8080

# 'google' is the only value production accepts; config.js refuses to start otherwise.
AUTH_VERIFIER=google

# ---- SEC-A2R ------------------------------------------------------------------------------------
# Required in production. An empty registry FAILS CLOSED and the process still starts, so that
# /healthz can say so; an UNSET path is indistinguishable from a mounted empty file until somebody is
# wrongly refused, which is why the source must at least be named.
OPERATOR_REGISTRY_FILE=/var/run/operators.json

# How far the gateway will trust a clock it does not control, in seconds. Bounded at 300.
CLOCK_SKEW_SECONDS=120

# The inbound request must outlive the upstream call, or the caller is disconnected while the gateway
# is still waiting and the outcome of that call is recorded nowhere.
REQUEST_TIMEOUT_MS=30000

# A bounded reply. Apps Script can return up to Cloud Run's 32 MiB ceiling, and buffering whatever
# arrives is how one upstream answer becomes this instance's memory.
MAX_UPSTREAM_BYTES=4194304

# Read the client address from X-Forwarded-For. Set to true ONLY behind infrastructure that OVERWRITES
# that header - Cloud Run does. Read directly from the internet it is whatever the caller typed, and
# every per-IP bound becomes per-whatever-they-claimed.
TRUST_PROXY=true

# Drain window on SIGTERM. Deliberately SHORTER than the platform's grace period, so the process
# chooses its own exit instead of being killed in the middle of one.
SHUTDOWN_GRACE_MS=8000
