{
 "round": "S3-R11",
 "what_this_file_is": "Output of assets/tests/_s3r11-interaction-runner.js: real headless Chrome, the real index.html, the real router and every production page module, over a production-shaped fixture world of 120 master SKUs / 360 marketplace SKUs / 360 regional rows / 360 pricing rows across 3 countries x 2 marketplaces. The only substitution is the transport answering from fixtures instead of the network.",
 "what_it_may_be_read_as": {
  "authoritative": [
   "REQUEST COUNTS per interaction, broken down by action (and by FC slice).",
   "DUPLICATE counts — the same question asked twice inside one interaction window.",
   "CONTROL FLOW and DOM outcomes: which section is visible, whether a skeleton is stuck, how many transport requests are still open."
  ],
  "NOT_authoritative": [
   "pollMs. Chrome runs this with --virtual-time-budget, which pauses the virtual clock during task execution and advances it to the next due timer. performance.now() therefore measures the number of 8 ms poll ticks the settle condition waited, NOT elapsed work. It is recorded because it distinguishes \"settled immediately\" from \"waited\", and for nothing else. Real per-interaction milliseconds are OPERATOR-OWNED and are collected with docs/evidence/s3-r11-interaction-performance/OPERATOR_INTERACTION_CAPTURE.md."
  ]
 },
 "server_ms_invariance": {
  "claim": "A request count is a property of the control flow, not of the latency.",
  "evidence": "The 0 ms and 400 ms runs below are identical on every api/dupes field.",
  "identical": true
 },
 "partial_loader_fix": {
  "interaction": "A -> B -> A in one tick, onto a page whose markup is not yet in the DOM",
  "PRE_partial_requests": 2,
  "POST_partial_requests": 1,
  "sections_in_dom_after": 1,
  "why_it_mattered": "Not the duplicated byte — it is a local file. Both .then() handlers ran target.innerHTML = html, so the second replacement destroyed the DOM the first mount had already wired listeners to and begun rendering into."
 },
